# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pricing — tiered per-ounce rates live in lib/pricing.ts.
# Uncomment only to force ONE flat rate at every jar size.
# NEXT_PUBLIC_HONEY_PRICE_PER_OZ=1.00

# Stripe (https://dashboard.stripe.com/apikeys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Database — local file for development; use Turso URL in production
DATABASE_URL=file:./data/honey.db
# DATABASE_AUTH_TOKEN=  # required for remote Turso

# Resend (https://resend.com) — order emails to customer + farm
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="Big Blue Barn Farm <orders@bigbluebarn.farm>"
# Optional: inbox for new-order alerts (defaults to contact@bigbluebarn.farm)
# ORDER_NOTIFY_EMAIL=you@example.com

# Inventory restock API (POST /api/inventory with header x-inventory-secret)
INVENTORY_ADMIN_SECRET=change-me-to-a-long-random-string

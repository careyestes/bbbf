                    {
                      "type": "text",
                      "id": "G3G6r",
                      "name": "Heading",
                      "fill": "$text-brown",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Our story starts in a little blue barn",
                      "lineHeight": 1.1,
                      "fontFamily": "$font-head",
                      "fontSize": 44,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "R4QZZ5",
                      "name": "Paragraph",
                      "fill": "$text-soft",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "We're a family farm rooted deep in the Mississippi Delta, just outside Shaw. What started with a couple of curious hives in the backyard has grown into a whole buzzing community of bees we're proud to call family.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "Pc6dw",
                      "name": "Paragraph",
                      "fill": "$text-soft",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Every season we tend our hives by hand, letting the bees do what they do best. When harvest comes, we bottle the honey raw and unfiltered, so all that natural goodness makes it straight into your jar.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "z3wGd",
                      "name": "Paragraph",
                      "fill": "$text-soft",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "No shortcuts, no additives, just pure Delta honey the way nature intended. We think you can taste the difference, and we can't wait for you to try it.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
